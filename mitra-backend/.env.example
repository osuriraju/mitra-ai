# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in password-reset emails)
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://rajuosuri@localhost:5432/mitra?schema=public

# Sessions (Redis)
REDIS_URL=redis://localhost:6379
SESSION_COOKIE=mitra_sid
# Long random string; sessions are keyed by an unguessable id, this signs the cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Email (password reset). Leave SMTP_HOST empty in dev to log reset links instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mitra AI <no-reply@mitra.local>"

# Logs
LOG_DIR=logs

# AI (optional). Leave the key empty to run with AI switched off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
