-- Money accounts (non-archived), in server order (createdAt asc).
CREATE TABLE accounts (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  mask TEXT NOT NULL,
  kind TEXT NOT NULL,
  balancePaise INTEGER NOT NULL,
  archived INTEGER NOT NULL,
  position INTEGER NOT NULL
);

selectAll:
SELECT * FROM accounts ORDER BY position, id;

selectById:
SELECT * FROM accounts WHERE id = ?;

selectIds:
SELECT id FROM accounts;

upsert:
INSERT OR REPLACE INTO accounts VALUES ?;

adjustBalance:
UPDATE accounts SET balancePaise = balancePaise + ? WHERE id = ?;

nextPosition:
SELECT COALESCE(MAX(position), -1) + 1 FROM accounts;

delete:
DELETE FROM accounts WHERE id = ?;

deleteAll:
DELETE FROM accounts;
